{
  "$schema": "https://unpkg.com/react-doctor/schema.json",
  "ignore": {
    "files": [
      ".expo/**",
      "dist/**",
      "node_modules/**",
      "src/components/ui/**",
      "src/components/features/workout/SportGraphicBanner.tsx",
      "src/constants/googleMapStyles.ts",
      "src/constants/statusColors.ts",
      "utils/gpxGenerator.ts"
    ]
  },
  "rules": {
    "deslop/unused-dependency": "off",
    "deslop/unused-file": "off",
    "react-doctor/rn-prefer-reanimated": "off",
    "socket/low-supply-chain-score": "off"
  }
}
