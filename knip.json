{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/services/authentication/index.ts",
    "src/hooks/mutations/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/components/features/health/SleepAnalysisCard.tsx"
  ],
  "ignoreDependencies": [
    "@react-aria/ssr",
    "@react-aria/utils",
    "react-aria",
    "react-stately",
    "expo-device",
    "expo-font",
    "tailwind-variants",
    "expo-updates"
  ],
  "ignoreExportsUsedInFile": true
}
